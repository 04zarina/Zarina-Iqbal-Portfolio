# Mail settings (set these in Vercel > Project > Settings > Environment Variables)
RESEND_API_KEY=
CONTACT_TO_EMAIL=zarinaiqbal04@gmail.com
# Optional: a sender on a domain you verified in Resend. Leave empty to use Resend's test sender.
CONTACT_FROM_EMAIL=

# RAG chatbot (Mochi). Without a key the bot still answers by quoting the best-matching source.
ANTHROPIC_API_KEY=
# Optional model override
CHAT_MODEL=claude-opus-5-5

# Security
ALLOWED_ORIGIN=http://localhost:3000
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=

# Public Analytics
VITE_ANALYTICS_DOMAIN=
